# Copy to backend/.env (gitignored). Only ANTHROPIC_API_KEY is required, and not even
# that if you have run `ant auth login` — the SDK picks up the profile automatically.
ANTHROPIC_API_KEY=

# Postgres from docker-compose.yml
HKN_DATABASE_URL=postgresql+psycopg://hkn:hkn@localhost:5434/hkn

# NCBI E-utilities etiquette: identify the tool and a contact address. An API key raises
# the rate limit from 3 to 10 requests/second (https://www.ncbi.nlm.nih.gov/account/).
HKN_NCBI_EMAIL=
HKN_NCBI_API_KEY=

# Per-stage model overrides. Everything defaults to claude-opus-5-5; claude-haiku-5-5 is
# a much cheaper option for the bulk contextualization stage.
# HKN_ANSWER_MODEL=claude-opus-5-5
# HKN_PLAN_MODEL=claude-opus-5-5
# HKN_CONTEXT_MODEL=claude-opus-5-5
# HKN_JUDGE_MODEL=claude-opus-5-5

# Answer mode: "claude" (default) or "extractive" (no model; quotes source sentences verbatim)
# HKN_ANSWER_MODE=claude

# Feature flags (used by the eval ablation ladder)
# HKN_ENABLE_QUERY_PLAN=true
# HKN_ENABLE_HYDE=true
# HKN_ENABLE_RERANK=true
